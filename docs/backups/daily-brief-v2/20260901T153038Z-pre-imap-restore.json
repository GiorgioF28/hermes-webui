                  {
                      "parameters":  {
                                         "jsCode":  "const rows = $input.all().map(({ json }) =\u003e {\n  const from = json.from?.value?.[0]?.address || json.from?.text || json.from || \u0027\u0027;\n  const fromName = json.from?.value?.[0]?.name || \u0027\u0027;\n  const subject = String(json.subject || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 200);\n  const receivedAt = new Date(json.date || json.receivedAt || Date.now()).toISOString();\n  return { account: String(json.account || \u0027\u0027), from: String(from), fromName: String(fromName), subject, receivedAt, listUnsubscribe: Boolean(json.headers?.[\u0027list-unsubscribe\u0027]) };\n});\nconst labels = [\u0027gmail-personale\u0027, \u0027gmail-secondario\u0027];\nreturn [{ json: { generatedAt: new Date().toISOString(), accounts: labels.map(label =\u003e ({ label, count: rows.filter(row =\u003e row.account === label).length, error: null })), noiseSkipped: 0, emails: rows } }];"
                                     },
